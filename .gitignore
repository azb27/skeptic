/data/*
!/data/.gitkeep
# runs: traces and caches stay local; per-case results are published so reports rebuild from a clone
/runs/*
!/runs/evals/
/runs/evals/*/*
!/runs/evals/*/results.jsonl
!/runs/repeats/
/runs/repeats/*
!/runs/repeats/results.jsonl
!/runs/p7/
/runs/p7/*
!/runs/p7/results.jsonl
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
# secrets: never commit
.env
*.env
.secrets/
# private: Aziz's harness code stays out of the public repo
/private/
runs_*.log
